APP_NAME=Lazarius Video AI
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_URL=http://localhost:3000

# Low-PC first: auto, cloud or local
RUNTIME_MODE=auto

# Optional local engines
COMFYUI_URL=http://localhost:8188
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# Cloud video adapter
# generic = POST /jobs
# vast = ComfyUI/Vast-style POST /generate/sync
CLOUD_VIDEO_PROVIDER=generic
CLOUD_VIDEO_API_URL=
CLOUD_VIDEO_API_KEY=
CLOUD_VIDEO_WORKFLOW=workflows/text_to_video.json
CLOUD_VIDEO_I2V_WORKFLOW=workflows/image_to_video_5b.json
CLOUD_VIDEO_TIMEOUT=900

# Public URL of this backend (required for cloud scene chaining / uploaded images)
PUBLIC_BASE_URL=
MAX_IMAGE_UPLOAD_MB=10

# Media adapters
TTS_PROVIDER=piper
PIPER_BIN=piper
PIPER_MODEL_PATH=
STT_PROVIDER=faster-whisper
WHISPER_MODEL=small
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=float16
MUSIC_PROVIDER=local_or_user_upload

STORAGE_DIR=./storage
FFMPEG_BIN=ffmpeg
