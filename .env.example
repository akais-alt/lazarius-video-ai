APP_NAME=Lazarius Video AI
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_URL=http://localhost:3000

RUNTIME_MODE=auto

COMFYUI_URL=http://localhost:8188
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

CLOUD_VIDEO_PROVIDER=generic
CLOUD_VIDEO_API_URL=
CLOUD_VIDEO_API_KEY=
CLOUD_VIDEO_WORKFLOW=workflows/text_to_video.json
CLOUD_VIDEO_I2V_WORKFLOW=workflows/image_to_video_5b.json
# Official Wan2.2 Animate 14B workflow. Install it as this file or point this variable to your deployed workflow.
CLOUD_VIDEO_ANIMATE_WORKFLOW=workflows/wan2_2_14B_animate.json
CLOUD_VIDEO_TIMEOUT=900

PUBLIC_BASE_URL=
MAX_IMAGE_UPLOAD_MB=10
MAX_MOTION_VIDEO_UPLOAD_MB=100

TTS_PROVIDER=piper
PIPER_BIN=piper
PIPER_MODEL_PATH=
STT_PROVIDER=faster-whisper
WHISPER_MODEL=small
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=float16
MUSIC_PROVIDER=local_or_user_upload

STORAGE_DIR=./storage
FFMPEG_BIN=ffmpeg
