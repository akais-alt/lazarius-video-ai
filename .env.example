APP_NAME=Lazarius Video AI
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_URL=http://localhost:3000

# Low-PC / Cloud-first runtime
# auto = cloud when no CUDA GPU is detected, local when CUDA is available
RUNTIME_MODE=auto

# Local optional services
COMFYUI_URL=http://localhost:8188
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# Generic cloud video adapter (optional)
# Leave empty to keep the app in planning/demo mode.
CLOUD_VIDEO_PROVIDER=generic
CLOUD_VIDEO_API_URL=
CLOUD_VIDEO_API_KEY=

STORAGE_DIR=./storage
FFMPEG_BIN=ffmpeg
WHISPER_MODEL=small
PIPER_MODEL_PATH=
