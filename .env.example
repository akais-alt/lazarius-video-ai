APP_NAME=Lazarius Video AI
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_URL=http://localhost:3000

# Low-PC first: auto, cloud or local
RUNTIME_MODE=auto

# Optional local engines (only use if the PC can handle them)
COMFYUI_URL=http://localhost:8188
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# Cloud video adapter. Keep empty to run in planning/demo mode.
CLOUD_VIDEO_PROVIDER=generic
CLOUD_VIDEO_API_URL=
CLOUD_VIDEO_API_KEY=

# Media adapters
TTS_PROVIDER=piper
STT_PROVIDER=whisper
MUSIC_PROVIDER=local_or_user_upload

STORAGE_DIR=./storage
FFMPEG_BIN=ffmpeg
WHISPER_MODEL=small
PIPER_MODEL_PATH=
